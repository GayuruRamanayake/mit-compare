# Required for both deployment paths below.
GEMINI_API_KEY=

# Only used by the docker-compose.yml path (local machine / plain VM,
# frontend and backend on different ports). Not read by the Swarm path —
# scripts/build.sh hardcodes the public HTTPS domain instead, since
# common_nginx serves frontend + backend under one hostname there.
VITE_API_BASE_URL=http://<vm-ip>:8000
